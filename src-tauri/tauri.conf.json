{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiSerial",
  "version": "0.1.0",
  "identifier": "dev.multiserial.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MultiSerial",
        "width": 1200,
        "height": 760,
        "minWidth": 920,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": []
  }
}
