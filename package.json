{
  "name": "multiSerial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "23.11.0",
    "pnpm": "10.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "dev": "node scripts/run-with-dev-env.mjs vite --host 127.0.0.1",
    "tauri:dev": "node scripts/run-with-dev-env.mjs tauri dev",
    "build": "tsc --noEmit && vite build",
    "tauri:build": "node scripts/run-with-dev-env.mjs tauri build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-with-test-env.mjs vitest run",
    "test:e2e": "node scripts/run-with-test-env.mjs playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "rust:test": "node scripts/run-with-test-env.mjs node scripts/run-rust.mjs cargo test --manifest-path src-tauri/Cargo.toml --features mock-serial",
    "rust:fmt": "node scripts/run-rust.mjs cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "node scripts/run-rust.mjs cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
